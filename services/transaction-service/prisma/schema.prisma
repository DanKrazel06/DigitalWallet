// transaction-service — Prisma schema.
//
// Owns:
//   - wallets    : LOCAL PROJECTION of wallet-service's wallets, kept in
//                  sync by consuming `wallet.created` events. Source of
//                  truth for transfers (balance debited / credited here).
//   - transactions : business-level transfer records (one per transfer).
//   - ledger_entries : immutable double-entry accounting movements
//                      (2 per transfer: one debit, one credit).
//   - outbox_events : Transactional Outbox pattern (publish to Kafka).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Wallet projection — fed by wallet.created Kafka events.
// transaction-service mutates `balance` directly during transfers; the
// new balance is later mirrored back to wallet-service via the
// `transaction.completed` event so wallet-service's GET /wallets stays
// consistent (eventual consistency).
// ---------------------------------------------------------------------------
model Wallet {
  id        String   @id @db.Uuid                  // same id as in wallet-service
  userId    String   @unique @map("user_id") @db.Uuid
  balance   BigInt   @default(0)
  currency  String   @db.VarChar(3)                // always 'USD' for now
  status    String   @default("active")            // active | frozen | closed
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("wallets")
}

// ---------------------------------------------------------------------------
// Transaction — the business fact of a transfer.
// `idempotency_key` is the UUID provided by the client in the
// `Idempotency-Key` HTTP header; UNIQUE so repeated calls return the same
// record instead of duplicating the transfer.
// ---------------------------------------------------------------------------
model Transaction {
  id              String        @id @default(uuid()) @db.Uuid
  idempotencyKey  String        @unique @map("idempotency_key") @db.Uuid
  fromWalletId    String        @map("from_wallet_id") @db.Uuid
  toWalletId      String        @map("to_wallet_id") @db.Uuid
  fromUserId      String        @map("from_user_id") @db.Uuid
  toUserId        String        @map("to_user_id") @db.Uuid
  amount          BigInt
  currency        String        @db.VarChar(3)
  status          String                                       // completed | failed
  failureReason   String?       @map("failure_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  ledgerEntries   LedgerEntry[]

  @@index([fromWalletId, createdAt], name: "tx_from_wallet_created_idx")
  @@index([toWalletId, createdAt], name: "tx_to_wallet_created_idx")
  @@map("transactions")
}

// ---------------------------------------------------------------------------
// LedgerEntry — immutable accounting movement.
// Each completed Transaction generates exactly 2 entries (one debit, one
// credit). Invariant for any transaction_id:
//     SUM(debit) - SUM(credit) = 0
//
// `balance_after` is the running balance of the wallet AFTER this entry
// is applied; lets us reconstruct historical balances without replaying
// every entry from the beginning.
// ---------------------------------------------------------------------------
model LedgerEntry {
  id            String       @id @default(uuid()) @db.Uuid
  transactionId String       @map("transaction_id") @db.Uuid
  walletId      String       @map("wallet_id") @db.Uuid
  debit         BigInt       @default(0)
  credit        BigInt       @default(0)
  balanceAfter  BigInt       @map("balance_after")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  transaction   Transaction  @relation(fields: [transactionId], references: [id])

  @@index([walletId, createdAt], name: "ledger_wallet_created_idx")
  @@map("ledger_entries")
}

// Standard Transactional Outbox row. Shared schema across all services.
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  aggregateId String    @map("aggregate_id")
  topic       String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, createdAt], name: "outbox_pending_idx")
  @@map("outbox_events")
}
