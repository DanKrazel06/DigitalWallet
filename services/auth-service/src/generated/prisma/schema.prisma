// auth-service — Prisma schema.
// Owns ONLY tables that belong to this microservice. No cross-service joins.
// Refresh tokens live in Redis (TTL native, O(1) revocation) — not modelled here.

generator client {
  provider        = "prisma-client-js"
  // postgresqlExtensions enables declarative management of PG extensions
  // (e.g. citext) directly from the schema, instead of running CREATE
  // EXTENSION manually in a SQL migration.
  previewFeatures = ["postgresqlExtensions"]
  // Generate the client into a local folder owned by this service.
  // pnpm's symlinked layout breaks the default location, so we keep the
  // generated artefacts inside src/ and import them by relative path.
  output          = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ---------------------------------------------------------------------------
// User — identity record. Password is hashed with Argon2id before storage.
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

// ---------------------------------------------------------------------------
// OutboxEvent — implements the Transactional Outbox pattern.
//
// On every state change that must be broadcast (user.created, user.deleted),
// a row is inserted in the SAME Postgres transaction as the business write.
// A background worker (relay) polls this table and publishes pending rows
// to Kafka, then marks them as published. Guarantees at-least-once delivery
// and avoids the dual-write problem (DB write + Kafka publish must stay
// consistent even if Kafka is down or the process crashes mid-flow).
// ---------------------------------------------------------------------------
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  // Identifies the entity the event is about (e.g. userId). Used as the
  // Kafka partition key so events for the same entity stay ordered.
  aggregateId String    @map("aggregate_id")
  // Destination Kafka topic, e.g. "walletdigital.user".
  topic       String
  // Full event envelope + payload, JSON-serialized. Workers send this verbatim.
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // Null until the relay successfully publishes to Kafka. Indexed so the
  // worker can SELECT unpublished rows efficiently.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, createdAt], name: "outbox_pending_idx")
  @@map("outbox_events")
}
