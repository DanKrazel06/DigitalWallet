// wallet-service — Prisma schema.
// Owns wallet records: ownership, currency, balance, status.
// `merchantId` references merchant-service data, NOT enforced by SQL FK
// (database-per-service principle — cross-service relations are
// event-driven).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Wallet — funds container belonging to one merchant.
//
// One wallet per merchant for this milestone (mono-currency USD). The
// merchant's `type` ('employee' | 'company') is owned by merchant-service
// and not duplicated here — wallet-service only holds the merchant link.
//
// `id` is the PRIMARY KEY (`@id`), a UUID auto-generated by Prisma. The
// `@db.Uuid` directive picks PostgreSQL's native uuid type (16-byte
// binary) instead of text, for compact storage and fast comparisons.
//
// `merchantId` is a SECONDARY unique constraint, NOT another primary key.
// The mono-currency assumption gives us "one merchant = one wallet". If
// we add multi-currency later, this becomes a composite unique
// (merchantId, currency).
//
// `balance` uses Decimal(20, 4) — 20 digits, 4 decimal places. The
// in-memory Money value object still uses bigint in minor units; the
// repository converts at the Prisma boundary. Floats are FORBIDDEN
// throughout (0.1 + 0.2 !== 0.3 in IEEE 754).
// ---------------------------------------------------------------------------
model Wallet {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @unique @map("merchant_id") @db.Uuid
  currency   String   @db.VarChar(3)
  balance    Decimal  @default(0) @db.Decimal(20, 4)
  status     String   @default("active") // 'active' | 'inactive'
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("wallets")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  aggregateId String    @map("aggregate_id")
  topic       String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, createdAt], name: "outbox_pending_idx")
  @@map("outbox_events")
}
