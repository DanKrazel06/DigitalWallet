# account-service — local environment template.
# Copy to .env (gitignored) and adapt as needed.

HOST=0.0.0.0
PORT=3002

NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://walletdigital:changeme_pg@127.0.0.1:5433/account?schema=public

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=account-service
# Kafka consumer group id — instances of this service load-balance partitions
# of subscribed topics within the same group.
KAFKA_CONSUMER_GROUP=account-service
