# ============================================================================
# WalletDigital — variables d'environnement
# Copier ce fichier en .env et adapter les valeurs.
# Le .env est gitignored, ne JAMAIS commiter de vrais secrets.
# ============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL (transactionnel : users, accounts, wallets, ledger)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
# Port 5433 is used (not the PG default 5432) to avoid a known Docker
# Desktop + Prisma + SCRAM port-forward issue on Windows.
POSTGRES_PORT=5433
POSTGRES_USER=walletdigital
POSTGRES_PASSWORD=changeme_pg
# Bases créées automatiquement par infra/postgres/init/01-create-databases.sh
POSTGRES_DB_MERCHANT=merchant
POSTGRES_DB_WALLET=wallet
POSTGRES_DB_TRANSACTION=transaction

# ---------------------------------------------------------------------------
# MongoDB (notifications, logs métier)
# ---------------------------------------------------------------------------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=walletdigital
MONGO_PASSWORD=changeme_mongo
MONGO_DB_NOTIFICATION=notification

# ---------------------------------------------------------------------------
# Redis (cache, sessions, rate-limit, idempotency)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis

# ---------------------------------------------------------------------------
# Kafka via Redpanda (bus d'événements)
# Depuis l'hôte : localhost:9092
# Depuis les conteneurs : redpanda:9093 (interne)
# Console UI : http://localhost:${KAFKA_CONSOLE_PORT}
# ---------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_PORT=9092
KAFKA_CONSOLE_PORT=8080

# ---------------------------------------------------------------------------
# Mailhog (capture d'emails en dev — pas de vrais envois)
# ---------------------------------------------------------------------------
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
